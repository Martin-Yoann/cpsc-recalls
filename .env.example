# KOI Recall — consumer web app (Next.js)
# Every var here is inlined into the client bundle at build time, so none of
# them may hold a secret.

# Backend API base URL. Leave empty in production to fall back to the deployed
# API; set http://localhost:3002 when developing against a local backend.
NEXT_PUBLIC_API_URL=

# Render bundled mock campaign fixtures when the API is unavailable.
# Development only — never enable in production, or a real recall page could
# display fabricated campaign data.
NEXT_PUBLIC_DEMO_MODE=false

# Google Analytics 4 property id, e.g. G-XXXXXXXXXX.
# Leave empty to disable analytics entirely: no tag is loaded and the
# trackEvent/trackPageView helpers no-op. See src/lib/analytics.ts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only. Shared secret guarding POST /api/revalidate, which the backend
# calls after publishing a campaign version so an edited recall notice appears
# immediately rather than after the revalidate window. Must match the backend's
# WEB_REVALIDATE_SECRET. With this unset the route returns 401 (fails closed)
# and invalidation falls back to the time window.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=
